# Publish API key (required for PUT /api/summary from n8n or local curl)
PUBLISH_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Production (Vercel): auto-injected when you connect a Blob store to the project.
#   BLOB_STORE_ID + VERCEL_OIDC_TOKEN (recommended), or BLOB_READ_WRITE_TOKEN.
# Must match your store type when creating the Blob store in Vercel dashboard:
#   private (default) or public
# BLOB_ACCESS=private
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
